# -----------------------------------------------------------------------------
# Socket & Enhanced Monitoring
# -----------------------------------------------------------------------------
# Proxy WebSocket connections through reverse proxy (1=enable, 0=disable)
SOCKET_PROXY=0
# HTTP endpoint health checks (1=enable, 0=basic docker stats only)
# Requires config/monitor_targets.json when enabled.
MONITOR_ENHANCED=0

# -----------------------------------------------------------------------------
# Rate Limiting — Redis distributed + per-user bucket
# -----------------------------------------------------------------------------
# Redis-backed global rate limit: 0=local limit_req only (prod default), 1=Redis (dev default)
# When 1, nginx resolves redis-rate-limit via Docker DNS (127.0.0.11); falls back to local limit_req if Redis down.
REDIS_RATE_LIMIT=0
# Per-user bucket: 1=enable limit_req zone per_user (5r/s, burst 20) on login/ranking locations
PER_USER_LIMIT=1
# Redis host/port for rate limiting (internal Docker DNS name, no host port)
REDIS_HOST=redis-rate-limit
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Prometheus + Grafana Monitoring Stack (optional, dev default off)
# -----------------------------------------------------------------------------
# Enable nginx stub_status + Prometheus scraping: 0=off (prod default), 1=on (dev)
# When 1, __domain.sh renders location /metrics inside the port 80 server (allow 127.0.0.1 + TAILSCALE_IP only)
MONITORING_ENABLED=0
# Prometheus + Grafana + node-exporter are gated by compose profile `monitoring`.
# Start with: docker compose --profile monitoring -f docker-compose.yml -f docker-compose.monitoring.yml up -d
#    or: docker compose -f docker-compose.domain.yml -f docker-compose.monitoring.yml --profile monitoring up -d
# Ports are bound to 127.0.0.1 only by default; override BIND_IP to expose via Tailscale if needed.
PROMETHEUS_PORT=9090
PROMETHEUS_BIND_IP=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_BIND_IP=127.0.0.1
GRAFANA_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
# Optional: Grafana public URL (for alerts/links)
GRAFANA_ROOT_URL=http://localhost:3001/
# Tailscale IP allowed to scrape /metrics (defaults to 127.0.0.1 if unset)
TAILSCALE_IP=127.0.0.1

# -----------------------------------------------------------------------------
# HSM — Hardware Security Module for TLS private key (optional, disabled)
# -----------------------------------------------------------------------------
# WHY: Keep grader TLS private key off disk / in hardware. Behind nginx/caddy TLS.
# Price: $0 SoftHSM (software emulation, dev/test) | ~$800 YubiHSM 2 (USB HSM for prod edge)
#        | ~$30/mo AWS CloudHSM (managed, for cloud deployments)
# Pros: key never on disk, PKCS#11 via certbot --hsm / PKCS#11 engine; survives disk leak
# Cons: complex renewal (PKCS#11 URI instead of file), needs HSM backup & PIN rotation
#       renewal: certbot --hsm --hsm-module /usr/lib/softhsm/libsofthsm2.so --hsm-pin $HSM_PIN
# Maintenance: back up SoftHSM token DB (config/hsm/tokens/* + *.db); YubiHSM: export wrapped key; CloudHSM: AWS backup
# Enable: set HSM_ENABLED=1 and choose HSM_MODULE; certbot uses --hsm flag with PKCS#11 URI
# Local overrides gitignored: config/hsm/*, *.db (see .gitignore)
# Disabled by default — prod stays off unless explicitly enabled.
HSM_ENABLED=0
# HSM_MODULE: softhsm | yubihsm | cloudhsm — PKCS#11 provider
#   softhsm  → opencrypto/softhsm (dev, uses /usr/lib/softhsm/libsofthsm2.so)
#   yubihsm  → yubico/yubihsm (hardware, needs /usr/lib/libyubihsm.so + reader)
#   cloudhsm → AWS CloudHSM PKCS#11 lib (client SDK at /opt/cloudhsm/lib/libcloudhsm_pkcs11.so)
HSM_MODULE=softhsm
# HSM_PIN: SoftHSM user PIN (e.g. 1234); YubiHSM auth key PIN; CloudHSM CU PIN — gitignored if in .env.local
HSM_PIN=
# HSM_KEY_LABEL: PKCS#11 label for grader TLS private key (lookup via pkcs11-tool -L)
HSM_KEY_LABEL=grader-privkey

# -----------------------------------------------------------------------------
# Vault — HashiCorp Vault for secret rotation / auto-rotation (optional, disabled)
# -----------------------------------------------------------------------------
# WHY: Centralize POSTGRES_PASSWORD / AUTH_SECRET / ranking creds with auto-rotation.
# Price: $0 self-hosted (hashicorp/vault:1.15) | ~$0.40/secret/mo AWS Secrets Manager alternative
# Pros: auto-rotation, audit log, lease renewal, no .env file sprawl
# Cons: need Vault server (another stateful service), token lifecycle, unseal
# Maintenance: Vault storage is file/raft at config/vault/data (gitignored); backup via `vault operator raft snapshot save`
# Alternative: scripts/__secrets-rotate.sh handles rotation without Vault — Vault header mentions this
# Enable: VAULT_ENABLED=1, set VAULT_ADDR/VAULT_TOKEN, secrets at VAULT_PATH (e.g. secret/cms)
# Local overrides gitignored: .env.local, .env.*.local, config/vault/data (see .gitignore)
# Disabled by default — prod uses .env files unless explicitly switched to Vault.
VAULT_ENABLED=0
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_PATH=secret/cms

# -----------------------------------------------------------------------------
# DNSSEC + CAA — DNS integrity + CA restriction (optional, DNS-only, disabled)
# -----------------------------------------------------------------------------
# WHY: DNS spoof protection (DNSSEC) + restrict which CA may issue for domain (CAA).
# Price: $0 (registry/DNS provider feature) but needs DNS control + computer center coordination for DS rollover
# Pros: DNSSEC → signed zone prevents spoof/BGP hijack; CAA → only letsencrypt.org (or chosen CA) may issue → blocks rogue CA
# Cons: key rollover ceremony (KSK/ZSK), DS at parent, clock skew can break resolution if misconfigured
# Maintenance: ZSK rollover ~90d, KSK ~ yearly; DS record at parent (MWIT/Thai registry); monitor with `dig +dnssec` + `delv`
# Enable: set DNSSEC_ENABLED=1 and/or CAA_ENABLED=1; publish records per docs/dnssec-caa-guide.md (DS + CAA)
# No compose change needed — DNS only. Disabled by default.
DNSSEC_ENABLED=0
CAA_ENABLED=0
# CAA_ISSUER: CA allowed to issue (letsencrypt.org | pki.goog | sectigo.com | digicert.com | comodoca.com)
CAA_ISSUER=letsencrypt.org

# -----------------------------------------------------------------------------
# mTLS — mutual TLS for CMS worker RPC (optional, disabled)
# -----------------------------------------------------------------------------
# WHY: Worker auth beyond Tailscale IP allowlist — client cert at RPC boundary.
# Price: $0 self-signed CA (openssl) | $0 CF Zero Trust alternative
# Pros: worker identity via cert, revocation via CRL, defense-in-depth past TAILSCALE_IP allow
# Cons: cert distribution to every worker node, rotation, CRL/OCSP plumbing
# Maintenance: CA at config/mtls/ca.pem (gitignored *.pem.local); worker certs at config/mtls/worker-*.pem; rotate ~ yearly
# Interaction with TAILSCALE_IP: when MTLS_WORKERS_ENABLED=0, firewall/TRUST stays TAILSCALE_IP allow ALL (existing behavior)
#   when MTLS_WORKERS_ENABLED=1, firewall SHOULD restrict RPC to mTLS only — see docs/optional-features.md
# Disabled by default — prod stays tailnet-only unless explicitly enabled.
MTLS_WORKERS_ENABLED=0
# MTLS_CA_CERT / MTLS_WORKER_CERT / MTLS_WORKER_KEY: paths mounted into worker/cms containers
# Use .pem.local suffix for local real certs so .gitignore keeps them out of git (see .gitignore *.pem.local)
MTLS_CA_CERT=config/mtls/ca.pem
MTLS_WORKER_CERT=config/mtls/worker.pem
MTLS_WORKER_KEY=config/mtls/worker-key.pem

# -----------------------------------------------------------------------------
# WAF — OWASP ModSecurity CRS (optional, plan-first, disabled by default)
# -----------------------------------------------------------------------------
# WAF is available but NOT forced. Both WAF and CAPTCHA (if enabled) can run together;
# WAF does NOT replace CAPTCHA — CAPTCHA stays authoritative for brute-force / login abuse.
# Disabled by default (WAF_ENABLED=0): grader-waf not started, no ports bound, nginx unaffected.
# Enable explicitly when ready:
#   1. Set WAF_ENABLED=1 in .env.infra and tune thresholds if desired.
#   2. Start with profile: docker compose --profile waf -f docker-compose.yml -f docker-compose.domain.yml -f docker-compose.waf.yml up -d
#      (or: docker compose -f docker-compose.domain.yml -f docker-compose.waf.yml --profile waf up -d)
#   3. Keep DetectionOnly for ~1 week, review /var/log/modsec_audit.log for false positives, whitelist per location,
#      then switch WAF_RULE_ENGINE to On. See docs/waf-tuning.md.
# Wiring: when enabled, grader-waf fronts grader-nginx-proxy via cms-network (BACKEND=http://grader-nginx-proxy:80).
# Default host port 8080 keeps WAF observable without rebinding production 443 — promote to 443 only when intentionally
# fronting prod (see docs/waf-tuning.md Wiring section). No break when off.
WAF_ENABLED=0
WAF_PORT=8080
WAF_BIND_IP=127.0.0.1
WAF_PARANOIA=1
WAF_ANOMALY_INBOUND=5
WAF_ANOMALY_OUTBOUND=4
WAF_RULE_ENGINE=DetectionOnly
