# Infrastructure Monitoring Configuration
# Copy this file to .env.infra and fill in the values

# Discord Integration
DISCORD_WEBHOOK_URL=
DISCORD_ROLE_ID=

# Monitoring Thresholds (Percentage)
MONITOR_CPU_THRESHOLD=80
MONITOR_MEM_THRESHOLD=80
MONITOR_DISK_THRESHOLD=80

# Monitoring Interval (seconds) — NOTE: compose currently pins MONITOR_INTERVAL=5
# in docker-compose.yml (monitor service); edit docker-compose.yml to honor this value
# if you change it here. Kept at 10 as example default.
MONITOR_INTERVAL=10
MONITOR_COOLDOWN=300

# Path to monitor disk usage for (default in container is /host)
DISK_PATH=/host

# Backup Settings
BACKUP_INTERVAL_MINS=1440
BACKUP_MAX_COUNT=50
BACKUP_MAX_AGE_DAYS=10
BACKUP_MAX_SIZE_GB=5

# Docker socket group ID — used if monitor needs docker.sock access
# Find with: stat -c %g /var/run/docker.sock  (or: stat -f %g /var/run/docker.sock on macOS)
DOCKER_GID=999

# -----------------------------------------------------------------------------
# Domain & TLS Configuration
# -----------------------------------------------------------------------------
# Primary domain for the CMS instance (mirrors .env.admin)
DOMAIN_NAME=grader.mwit.ac.th
# TLS certificate method: letsencrypt | provided | selfsigned
DOMAIN_CERT_METHOD=letsencrypt
# HSTS max-age in seconds (300 = staging ramp-up; 31536000 = production)
HSTS_MAX_AGE=300

# -----------------------------------------------------------------------------
# Offsite Backup Configuration (via Tailscale)
# -----------------------------------------------------------------------------
# Tailscale IP of the remote backup node
OFFSITE_TAILNET_NODE=100.75.203.112
# Encryption key for offsite backups (generate with: openssl rand -hex 32)
OFFSITE_ENCRYPT_KEY=
# Remote backup destination path on the offsite node
OFFSITE_BACKUP_PATH=/var/local/backups/cms

# -----------------------------------------------------------------------------
# Socket & Enhanced Monitoring
# -----------------------------------------------------------------------------
# Proxy WebSocket connections through reverse proxy (1=enable, 0=disable)
SOCKET_PROXY=0
# HTTP endpoint health checks (1=enable, 0=basic docker stats only)
# Requires config/monitor_targets.json when enabled.
MONITOR_ENHANCED=0

# -----------------------------------------------------------------------------
# Rate Limiting — Redis distributed + per-user bucket
# -----------------------------------------------------------------------------
# Redis-backed global rate limit: 0=local limit_req only (prod default), 1=Redis (dev default)
# When 1, nginx resolves redis-rate-limit via Docker DNS (127.0.0.11); falls back to local limit_req if Redis down.
REDIS_RATE_LIMIT=0
# Per-user bucket: 1=enable limit_req zone per_user (5r/s, burst 20) on login/ranking locations
PER_USER_LIMIT=1
# Redis host/port for rate limiting (internal Docker DNS name, no host port)
REDIS_HOST=redis-rate-limit
REDIS_PORT=6379
