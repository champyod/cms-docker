# This file is auto-generated by `./cms config sync` from config.toml.
# Do not edit directly — edit config.toml instead.

# -----------------------------------------------------------------------------
# Core Services Connection
# -----------------------------------------------------------------------------
# Hostname or IP address of the server running core services
# For local workers: use 'localhost' or service name (e.g., 'cms-log-service')
# For remote workers: use your VPS public IP (e.g., '203.0.113.45')
# Same-host default: compose DNS name. For a remote main server, set its IP/hostname.
CORE_SERVICES_HOST=cms-log-service

# -----------------------------------------------------------------------------
# Main Database Connection (Optional on same host, required for remote worker-only nodes)
# -----------------------------------------------------------------------------
# Uses the same POSTGRES_* variable names as .env.core.
# - Same machine (main + worker): you can keep DB config only in .env.core.
# - Remote worker-only machine: set these values here to reach the main DB.
# These values are used to inject [database] url into config/cms.toml.
# POSTGRES_HOST: Database server address (IP or hostname), e.g. 192.168.1.10
# Remote worker-only machines: uncomment and point at the main DB host.
#POSTGRES_HOST=192.168.1.10
# Same-machine deployments: leave the four below commented — values are
# inherited from .env.core during `make env`.
# Remote worker-only machines: uncomment and point at the main DB.
#POSTGRES_PORT=5432
#POSTGRES_DB=cmsdb
#POSTGRES_USER=cmsuser
#POSTGRES_PASSWORD=change_me

# -----------------------------------------------------------------------------
# CMS Configuration
# -----------------------------------------------------------------------------
# Loaded from .env.core
# CMS_CONFIG=/usr/local/etc/cms.toml

# -----------------------------------------------------------------------------
# Worker Configuration
# -----------------------------------------------------------------------------
# Worker shard - MUST be unique for each worker instance
# Start from 0 for local workers, use higher numbers (10+) for remote workers
WORKER_SHARD=0

# Worker identification name
WORKER_NAME=worker-0

# Worker listen port (used for healthcheck / RPC; configurable via compose)
WORKER_PORT=26000

# Remote workers: main server's routable Postgres address.
# cms.toml defaults to hostname "database", which only resolves on the main
# server's compose network. Set these so config injection writes the real
# address instead (e.g. Tailscale IP of the main server).
# WORKER_DB_HOST=203.0.113.45
# WORKER_DB_PORT=5432

# Isolate cgroup delegation — set to 0 to disable cgroup v2 delegation for isolate
ISOLATE_CGROUP_CONTROL=1
# Path where isolate cgroups are mounted (must exist when ISOLATE_CGROUP_CONTROL=1;
# create via scripts/__worker_cgroup_setup.sh)
ISOLATE_CGROUP_PATH=/sys/fs/cgroup/cms-isolate

# -----------------------------------------------------------------------------
# Sandbox Settings
# -----------------------------------------------------------------------------
# Keep sandbox directories after evaluation (warning: uses disk space)
KEEP_SANDBOX=false

# Maximum file size in KB that solutions can write (default: 1GB)
MAX_FILE_SIZE=1048576

# -----------------------------------------------------------------------------
# Resource Limits
# -----------------------------------------------------------------------------
# CPU cores limit for this worker
WORKER_CPU_LIMIT=4

# Memory limit for this worker
WORKER_MEMORY_LIMIT=4G

# CPU cores reservation (minimum guaranteed)
WORKER_CPU_RESERVATION=1

# Memory reservation (minimum guaranteed)
WORKER_MEMORY_RESERVATION=1G

# -----------------------------------------------------------------------------
# Scaling Configuration
# -----------------------------------------------------------------------------
# Number of worker replicas (for Docker Swarm/Kubernetes)
WORKER_REPLICAS=1

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
# Loaded from .env.core
# CMS_LOG_DIR=/var/local/log/cms
# CMS_CACHE_DIR=/var/local/cache/cms
# CMS_DATA_DIR=/var/local/lib/cms

# -----------------------------------------------------------------------------
# mTLS — mutual TLS for worker RPC (optional, disabled) — mirror of .env.infra
# -----------------------------------------------------------------------------
# WHY: Authenticate workers with client certs, not just TAILSCALE_IP. See .env.infra for full why/price/maintenance.
# Price: $0 self-CA. Pros: worker identity. Cons: cert distribution. Maintain: config/mtls/* gitignored.
# Disabled by default — prod stays TAILSCALE_IP allow ALL unless explicitly enabled.
# Local overrides gitignored: config/mtls/*.pem, *.pem.local
MTLS_WORKERS_ENABLED=0
MTLS_CA_CERT=config/mtls/ca.pem
MTLS_WORKER_CERT=config/mtls/worker.pem
MTLS_WORKER_KEY=config/mtls/worker-key.pem