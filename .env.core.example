# This file is auto-generated by `./cms config sync` from config.toml.
# Do not edit directly — edit config.toml instead.
# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Access Method: "public_port" or "domain"
# - public_port: Use IP:Port (e.g., http://1.2.3.4:8888) - Easiest for testing
# - domain: Use domain names (e.g., http://contest.cms.local) - Requires DNS/Hosts
ACCESS_METHOD=public_port

# Public IP address of your VPS/server (for remote worker connection)
# Leave as 0.0.0.0 for localhost, or set your public IP
PUBLIC_IP=0.0.0.0
# Example: PUBLIC_IP=203.0.113.45

# Tailscale / VPN Configuration (Security)
# If using remote workers, set this to your Tailscale IP to restrict RPC ports.
# If empty, RPC ports will only be accessible via 127.0.0.1 (Local only).
# Set to 0.0.0.0 to make RPC ports public (NOT RECOMMENDED).
TAILSCALE_IP=
REMOTE_WORKERS_ENABLED=false

# Domain (managed by ./cms domain setup)
# Base domain for all CMS services. Sub-services are derived as:
#   admin.${CMS_DOMAIN}, ranking.${CMS_DOMAIN}, contest.${CMS_DOMAIN}
# Default: cms.local (local-only, no DNS needed)
<<<<<<< HEAD
# e.g. CMS_DOMAIN=grader.mwit.ac.th when ACCESS_METHOD=domain
=======
# e.g. CMS_DOMAIN=cms.local when ACCESS_METHOD=domain
>>>>>>> feat/customizable-cms
CMS_DOMAIN=cms.local

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Database Connection Details
POSTGRES_HOST=database
POSTGRES_PORT=5432
# External port to expose on the host (change this if 5432 is taken)
POSTGRES_PORT_EXTERNAL=5432
POSTGRES_DB=cmsdb
POSTGRES_USER=cmsuser
POSTGRES_PASSWORD=YOUR_DB_PASSWORD_HERE
POSTGRES_HOST_AUTH_METHOD=md5

# -----------------------------------------------------------------------------
# CMS Configuration
# -----------------------------------------------------------------------------
CMS_CONFIG=/usr/local/etc/cms.toml

# -----------------------------------------------------------------------------
# Service Shards (Instance Numbers)
# -----------------------------------------------------------------------------
LOG_SERVICE_SHARD=0
RESOURCE_SERVICE_SHARD=0
SCORING_SERVICE_SHARD=0
EVALUATION_SERVICE_SHARD=0
PROXY_SERVICE_SHARD=0
CHECKER_SERVICE_SHARD=0

# -----------------------------------------------------------------------------
# Worker Configuration
# -----------------------------------------------------------------------------
# Connected workers are managed through the Admin Panel UI
# Format: WORKER_N=hostname:port (e.g., WORKER_0=cms-worker-0:26000)
# These will be injected into cms.toml when running 'make env'
# Add workers via Admin UI -> Infrastructure -> Resources

# -----------------------------------------------------------------------------
# Image / Build Configuration
# -----------------------------------------------------------------------------
# Docker image tag used by docker-compose.yml (all services default to this)
IMG_TAG=major-admin-panel
# APT mirror for Docker builds (override for CN/regional mirrors)
# e.g. APT_MIRROR=mirrors.aliyun.com  or  APT_MIRROR=archive.ubuntu.com
APT_MIRROR=archive.ubuntu.com

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
CMS_LOG_DIR=/var/local/log/cms
CMS_CACHE_DIR=/var/local/cache/cms
CMS_DATA_DIR=/var/local/lib/cms

# -----------------------------------------------------------------------------
# mTLS — mutual TLS for worker RPC (optional, disabled) — mirror of .env.infra
# -----------------------------------------------------------------------------
# WHY: Authenticate workers with client certs, not just TAILSCALE_IP. See .env.infra for full why/price/maintenance.
# Price: $0 self-CA. Pros: worker identity. Cons: cert distribution. Maintain: config/mtls/* gitignored.
# Disabled by default — prod stays TAILSCALE_IP allow ALL unless explicitly enabled.
# Local overrides gitignored: config/mtls/*.pem, *.pem.local
MTLS_WORKERS_ENABLED=0
MTLS_CA_CERT=config/mtls/ca.pem
MTLS_WORKER_CERT=config/mtls/worker.pem
MTLS_WORKER_KEY=config/mtls/worker-key.pem
