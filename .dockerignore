.dockerignore
Dockerfile
.vagrant/
codecov/
.dev/
.venv/
.git/
.jj/
node_modules/
**node_modules/
.ruff_cache/
.vscode/
.idea/
docs/
examples/
*.md
backups/
drills/
# Developer/CI suites only; a running deployment never reaches them.
tests/

# Never ship live secrets or runtime state in image layers: config.toml and
# .env are the generated sources of truth (auto-generated secrets), and the
# live config/*.toml / nginx files carry the injected credentials.
config.toml
.env
.env.*
!.env.*.example
config/cms.toml
config/grader.nginx.conf
config/letsencrypt/
config/container-restart.json
config/modsecurity/modsec_audit.log
config/modsecurity/modsec_debug.log
prometheus-data/
grafana-data/
.agent/
.omo/
.tools/

# Preserve the src/ tree in the image despite the docs/md exclusions above
!src/
!src/**
