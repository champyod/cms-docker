# config.toml — Single source of truth for CMS deployment.
# Run `./cms config sync` after editing to regenerate .env file.
# This file is gitignored. Only config.toml.example is tracked.

[core]
COMPOSE_PROJECT_NAME = "cms-docker" # str; docker compose project name; must match existing container project
PUBLIC_IP = "0.0.0.0"           # str; your VPS public IP; live_ip auto-detects
INNER_IP = ""                  # str; peer address: worker RPC bind + worker dial target; empty=127.0.0.1 only
REMOTE_WORKERS_ENABLED = false  # bool
CMS_DOMAIN = "cms.local"        # str; base domain; sub-services are admin.${CMS_DOMAIN} etc.
POSTGRES_HOST = "database"      # str
POSTGRES_PORT = 5432            # port
POSTGRES_PORT_EXTERNAL = 5432   # port
POSTGRES_DB = "cmsdb"           # str
POSTGRES_USER = "cmsuser"       # str
POSTGRES_PASSWORD = ""          # secret; auto-generated if empty on first sync
POSTGRES_BACKUP_PASSWORD = ""    # secret; auto-generated if empty; backup role cms_backup (BYPASSRLS + member of cmsuser for large-object reads)
POSTGRES_HOST_AUTH_METHOD = "md5"
CMS_SECRET_KEY = ""             # secret; auto-generated hex32 if empty; injected into cms.toml
CMS_CONFIG = "/usr/local/etc/cms.toml"
CMS_SOURCE_URL = "https://github.com/champyod/cms-docker" # str; AGPL-13 Corresponding Source offer shown in the UI credits; point at your own fork
LOG_SERVICE_SHARD = 0           # num
RESOURCE_SERVICE_SHARD = 0      # num
SCORING_SERVICE_SHARD = 0       # num
EVALUATION_SERVICE_SHARD = 0    # num
PROXY_SERVICE_SHARD = 0         # num
CHECKER_SERVICE_SHARD = 0       # num
CMS_LOG_DIR = "/var/local/log/cms"
CMS_CACHE_DIR = "/var/local/cache/cms"
CMS_DATA_DIR = "/var/local/lib/cms"
IMG_TAG = "major-admin-panel"   # str
APT_MIRROR = "archive.ubuntu.com"
MTLS_WORKERS_ENABLED = 0        # enum:0,1; price: $0 self-CA; warning: cert distribution
MTLS_CA_CERT = "config/mtls/ca.pem"
MTLS_WORKER_CERT = "config/mtls/worker.pem"
MTLS_WORKER_KEY = "config/mtls/worker-key.pem"
APT_PORTS_MIRROR = "ports.ubuntu.com"   # str; ARM64 apt mirror (Raspberry Pi worker builds)
BASE_IMAGE = "ubuntu:noble"             # str; worker/base build image
DB_BIND_IP = "127.0.0.1"                # str; address postgres publishes 5432 on
CERT_EMAIL = ""                         # str; Let's Encrypt registration email
CERTBOT_IMAGE = "certbot/certbot"       # str; certbot image; set certbot/dns-cloudflare for DNS-01
TLS_CERTRESOLVER = "letsencrypt"        # str; traefik certresolver label
CMS_RANKING_CONFIG = "/usr/local/etc/cms_ranking.toml"

[admin]
DEPLOYMENT_TYPE = "img"         # enum:img,src
ADMIN_LISTEN_PORT = 8889        # port
ADMIN_PORT_EXTERNAL = 8889      # port
ADMIN_NEXT_PORT_EXTERNAL = 8891 # port
ADMIN_NEXT_DOMAIN = "admin-next.cms.local"
ADMIN_DOMAIN = "admin.cms.local"
ADMIN_BIND_IP = "127.0.0.1"     # csv; addresses the classic admin UI is published on; loopback keeps it reachable only through the proxy — set it to 0.0.0.0 to expose the port to the LAN
ADMIN_NEXT_BIND_IP = "127.0.0.1" # csv; addresses the Next.js admin panel is published on
RANKING_BIND_IP = "127.0.0.1"   # csv; addresses the ranking board is published on
ADMIN_COOKIE_DURATION = 36000   # num; seconds
AUTH_SECRET = ""                # secret; auto-generated hex32 if empty
CAPTCHA_ENABLED = 0             # enum:0,1; effect: reduces brute-force before fail2ban
CAPTCHA_PROVIDER = "turnstile"  # enum:turnstile,hcaptcha; only used if CAPTCHA_ENABLED=1
CAPTCHA_SITE_KEY = ""           # str
CAPTCHA_SECRET_KEY = ""         # secret
CAPTCHA_THRESHOLD = 3           # num
CAPTCHA_BAN_THRESHOLD = 5       # num
LOGIN_RATE_LIMIT_REDIS_ENABLED = 0  # enum:0,1; effect: keeps the login failure counters in a shared Redis so a lockout survives a web server restart
LOGIN_RATE_LIMIT_REDIS_HOST = "redis-rate-limit" # str; compose service name; counts per process only unless LOGIN_RATE_LIMIT_REDIS_ENABLED=1
LOGIN_RATE_LIMIT_REDIS_PORT = 6379 # port
RANKING_LISTEN_PORT = 8890      # port
RANKING_PORT_EXTERNAL = 8890    # port
RANKING_DOMAIN = "ranking.cms.local"
RANKING_USERNAME = "admin"      # str
RANKING_PASSWORD = ""           # secret; auto-generated if empty
RANKING_LOGO_PATH = ""          # str; host path to ranking logo (png/jpg/gif/bmp) e.g. "./config/assets/logo.png" — synced to ranking volume on ./cms config sync (hot-swap, overwrites old)
CMS_RANKING_LOG_DIR = "/var/local/log/cms/ranking"
CMS_RANKING_LIB_DIR = "/var/local/lib/cms/ranking"
DOMAIN_NAME = ""                # str; primary FQDN (e.g. grader.example.org); empty=cms.local
DOMAIN_CERT_METHOD = "letsencrypt" # enum:letsencrypt,provided,selfsigned
AUTO_RETRY = 0            # enum:0,1; retry cert issuance while DNS/:80 propagate
CERT_RETRY_ATTEMPTS = 8   # num; 0 = unlimited
CERT_RETRY_INTERVAL = 15  # num; seconds; doubles each attempt up to 120
CERT_RETRY_FOREVER = 0    # enum:0,1; equal to --retry-forever (sets attempts to 0)
EXTRA_DOMAINS = ""        # str; extra SAN hostnames, space separated
DEPLOY_HOOK = ""          # str; command run after a successful renewal
LE_STAGING = 0            # enum:0,1; use the Let's Encrypt test CA
FORCE_RENEWAL = 0         # enum:0,1; reissue even if the current cert is still valid
WAIT_PORT80_TIMEOUT = 0   # num; seconds to wait for :80 before issuing; 0 = no wait
BACKUP_CERTS = 0          # enum:0,1; back up the cert store before replacing it
AUTO_RENEW = 0            # enum:0,1; end a live setup by forcing a renewal
CERT_RETRY_INTERVAL_CAP = 120  # num; seconds; ceiling the retry backoff grows to
USE_LOCK = 0              # enum:0,1; flock to stop overlapping runs
DNS_PROVIDER = ""         # str; DNS-01 provider (e.g. cloudflare); empty = HTTP-01
DNS_CREDENTIALS_FILE = "" # str; credential file for the DNS plugin
DOMAIN_NGINX_BIND_IP = "" # str; address the domain nginx publishes 80/443 on; empty=engine wildcard on every interface (IPv4 and IPv6) — the public entry, set it to the box address to narrow it
HSTS_MAX_AGE = 31536000        # num; seconds; 1 year. Lower it only while staging
SOCKET_PROXY = 0                # enum:0,1
MONITOR_ENHANCED = 0            # enum:0,1
REDIS_RATE_LIMIT = 0            # enum:0,1
PER_USER_LIMIT = 1              # num
REDIS_HOST = "redis-rate-limit" # str
REDIS_PORT = 6379               # port
WAF_ENABLED = 0                 # enum:0,1; warning: tune DetectionOnly 1 week first
WAF_PORT = 8080                 # port
WAF_PARANOIA = 1                # num
WAF_ANOMALY_INBOUND = 5         # num
WAF_RESP_BODY_ACCESS = "Off"    # enum:Off,On,Force,Rejected; ModSecurity respBodyAccess; buffers every response body to inspect it
DOMAIN_NGINX_HTTP_PORT = 80     # port; domain nginx HTTP publish port
DOMAIN_NGINX_HTTPS_PORT = 443   # port; domain nginx HTTPS publish port
RANKING_AUTH_DIRECTIVES = ""    # str; extra nginx auth directives for the ranking vhost
CONTEST_ROUTE_PATH = "/"        # str; sub-path the contest UI answers on the primary vhost; must start with "/" and be unique per vhost
ADMIN_ROUTE_PATH = "/admin"     # str; sub-path the Next.js panel answers on the primary vhost
ADMIN_CLASSIC_ROUTE_PATH = "/classic" # str; sub-path the classic admin API answers on the primary AND the admin vhost
RANKING_ROUTE_PATH = "/ranking" # str; sub-path the ranking board answers on the primary vhost
OJ_ROUTE_PATH = ""              # str; sub-path the external judge answers on the primary vhost; empty=served on the oj vhost only
OJ_UPSTREAM = ""                # str; external judge upstream; empty=host.docker.internal with OJ_BACKEND_PORT (the judge runs on the host, the proxy in a container)
CONTEST_UPSTREAM = "cms-contest-web-server" # str; container the contest route proxies to
ADMIN_UPSTREAM = "cms-admin-panel-next"     # str; container the admin route proxies to
ADMIN_CLASSIC_UPSTREAM = "cms-admin-web-server" # str; container the classic admin route proxies to
RANKING_UPSTREAM = "cms-ranking-web-server" # str; container the ranking route proxies to
ADMIN_NEXT_LISTEN_PORT = 3000   # port; container port the Next.js panel answers on

[rpc]
RPC_SECRET = ""               # secret; auto-generated hex32 if empty; shared inter-service RPC secret
RPC_ALLOW_BACKDOOR = false    # bool; allow remote start_backdoor/stop_backdoor via RPC (requires secret)

[contest]
CONTEST_ID = 1                  # num; ACTIVE contest served by the contest stack; single source of truth (docker compose reads ${CONTEST_ID}); the admin panel writes here, never the generated .env
CONTEST_DOMAIN = ""             # str; FQDN contestants use; empty=CMS_DOMAIN
CONTEST_LISTEN_PORT = 8888      # port
CONTEST_BIND_IP = "127.0.0.1"   # csv; addresses the contest web UI is published on; loopback keeps it reachable only through the proxy — set it to 0.0.0.0 to expose the port to the LAN
ACTIVE_CONTEST_PORT = 8888      # port; legacy alias — mapped to CONTEST_LISTEN_PORT when that is empty
SECRET_KEY = ""                 # secret; auto-generated hex32 if empty
COOKIE_DURATION = 10800         # num; seconds
NUM_PROXIES_USED = 1            # num
MAX_SUBMISSION_LENGTH = 100000  # num
MAX_INPUT_LENGTH = 5000000      # num
SUBMIT_LOCAL_COPY = true        # bool
CONTEST_WEB_CPU_LIMIT = "2"     # str
CONTEST_WEB_MEMORY_LIMIT = "2G" # str
ENABLE_TLS = false              # bool
CONTEST_PORT_EXTERNAL = 8888    # port; host port contestants reach
CONTEST_WEB_SERVER_SHARD = 0    # num
CONTEST_WEB_CPU_RESERVATION = "0.1"     # str
CONTEST_WEB_MEMORY_RESERVATION = "256M" # str
NGINX_BIND_IP = "0.0.0.0"       # str; address the standalone contest nginx publishes 80/443 on
NGINX_HTTP_PORT = 80            # port
NGINX_HTTPS_PORT = 443          # port
NGINX_EXTERNAL_PORT = 80        # port; legacy alias
OJ_DOMAIN = ""                  # str; external judge host; empty=off
OJ_BACKEND_PORT = 9000          # port

[worker]
CORE_SERVICES_HOST = "cms-log-service" # str; remote workers: main server IP
WORKER_SHARD = 0                # num; MUST be unique per instance
WORKER_NAME = "worker-0"        # str
WORKER_PORT = 26000             # port
WORKER_BIND_ADDR = "0.0.0.0"    # str; RPC bind address; a remote worker sets this to its own Tailscale IP so 26000 is not published on every interface
WORKER_REPLICAS = 1             # num
WORKER_CPU_LIMIT = "2"          # str
WORKER_MEMORY_LIMIT = "2G"      # str
WORKER_CPU_RESERVATION = "1"    # str
WORKER_MEMORY_RESERVATION = "1G"
ISOLATE_CGROUP_CONTROL = 1      # enum:0,1
ISOLATE_CGROUP_PATH = "/sys/fs/cgroup/cms-isolate"
KEEP_SANDBOX = false            # bool
MAX_FILE_SIZE = 1048576         # num; KB

[infra]
DISCORD_WEBHOOK_URL = ""        # url; optional
DISCORD_ROLE_ID = ""            # str
MONITOR_CPU_THRESHOLD = 80      # num; percent
MONITOR_MEM_THRESHOLD = 80      # num
MONITOR_DISK_THRESHOLD = 80     # num
MONITOR_INTERVAL = 10           # num; seconds
DISK_PATH = "/host"             # str
BACKUP_INTERVAL_MINS = 1440     # num
BACKUP_MAX_COUNT = 50           # num
BACKUP_MAX_AGE_DAYS = 10        # num
BACKUP_MAX_SIZE_GB = 5          # num
DOCKER_GID = 999                # num; find with: stat -c %g /var/run/docker.sock
DOCKER_UID = 1000               # num; find with: stat -c %u backups (monitor image build arg; backup write access)
OFFSITE_TAILNET_NODE = ""       # str; Tailscale IP of remote backup node
OFFSITE_ENCRYPT_KEY = ""        # secret; openssl rand -hex 32
OFFSITE_BACKUP_PATH = "/var/local/backups/cms"
MONITORING_ENABLED = 0          # enum:0,1
PROMETHEUS_PORT = 9090          # port
PROMETHEUS_BIND_IP = "127.0.0.1"
GRAFANA_PORT = 3001             # port
GRAFANA_BIND_IP = "127.0.0.1"
FUNNEL_BIND_IP = "127.0.0.1"     # str; address the funnel panel/ranking gateways publish on; loopback keeps them reachable only through the proxy, set it to the tailnet IP to reach them directly
GRAFANA_ADMIN_USER = "admin"    # str
GRAFANA_PASSWORD = ""           # secret; default 'admin' is insecure
GRAFANA_ROOT_URL = "http://localhost:3001/"
HSM_ENABLED = 0                 # enum:0,1; price: $0 SoftHSM | ~$800 YubiHSM 2
HSM_MODULE = "softhsm"          # enum:softhsm,yubihsm,cloudhsm
HSM_PIN = ""                    # secret
HSM_KEY_LABEL = "grader-privkey"
VAULT_ENABLED = 0               # enum:0,1; price: $0 self-hosted | ~$0.40/secret/mo cloud
VAULT_ADDR = "http://vault:8200"
VAULT_TOKEN = ""                # secret
VAULT_PATH = "secret/cms"
DNSSEC_ENABLED = 0              # enum:0,1; requires DNS control
CAA_ENABLED = 0                 # enum:0,1
CAA_ISSUER = "letsencrypt.org"
DNS_PROVIDER = ""               # enum:"",cloudflare; "" = HTTP-01 webroot, cloudflare = DNS-01 (wildcard / :80 unreachable)
CLOUDFLARE_API_TOKEN = ""       # secret; DNS-01 only — zone:DNS:Edit token, turned into certbot's cloudflare.ini
MTLS_WORKERS_ENABLED = 0        # enum:0,1; mirrors [core]
WAF_ENABLED = 0                 # enum:0,1; mirrors [admin]
WAF_PORT = 8080
WAF_BIND_IP = "127.0.0.1"
WAF_PARANOIA = 1
WAF_ANOMALY_INBOUND = 5
WAF_ANOMALY_OUTBOUND = 4
WAF_RULE_ENGINE = "DetectionOnly"
WAF_RESP_BODY_ACCESS = "Off"    # mirrors [admin]
CMS_LOG_MAX_AGE_DAYS = 7            # num
CMS_LOG_MAX_SIZE_GB = 5             # num
CMS_LOG_PRUNE_INTERVAL_MINS = 60    # num
FUNNEL_ENABLED = false              # bool; tailnet funnel (public ts.net behind basic auth)
FUNNEL_REALM = "CMS restricted"     # str
FUNNEL_CONTEST_LISTEN = 8443        # port
FUNNEL_PANEL_LISTEN = 8892          # port
FUNNEL_RANKING_LISTEN = 8893        # port
VAULT_BIND_IP = "127.0.0.1"         # str
VAULT_PORT = 8200                   # port

[tailscale]
TAILSCALE_AUTHKEY = ""          # secret; tskey-auth-... from the Tailscale admin console (user-provided)
TAILSCALE_HOSTNAME = "cms-contest" # str; hostname the tailscale sidecar registers as
TS_HTTPS_PANEL = 8843            # port; tailscale serve HTTPS -> admin panel :8891
TS_HTTPS_CLASSIC = 8844          # port; tailscale serve HTTPS -> classic admin :8889
TS_HTTPS_RANKING = 8845          # port; tailscale serve HTTPS -> ranking :8890
