# Funnel mirror nginx config — envsubst template
# Mirrors grader layout on Tailscale funnel ports with basic_auth wrappers.
# Rendered by __domain.sh → config/funnel-mirror.nginx.conf
# Render with: envsubst '$DOMAIN_NAME $CONTEST_LISTEN_PORT ...' < template > output

# Rate limit zones
limit_req_zone $binary_remote_addr zone=funnel_login:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=funnel_ranking:10m rate=10r/s;

# ── Upstreams (same as grader, separate names to avoid conflicts) ──
upstream funnel_cms_contest {
    least_conn;
    server cms-contest-web-server:${CONTEST_LISTEN_PORT};
}

upstream funnel_cms_admin_panel {
    server cms-admin-panel-next:3000;
}

upstream funnel_cms_classic_admin {
    server cms-admin-web-server:${ADMIN_LISTEN_PORT};
}

upstream funnel_cms_ranking {
    server cms-ranking-web-server:${RANKING_LISTEN_PORT};
}

# ── Funnel: Contest (port 8443) ──────────────────────────────────
server {
    listen ${FUNNEL_CONTEST_LISTEN} ssl http2;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    include /etc/nginx/conf.d/nginx-ssl.conf;
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}; includeSubDomains" always;

    auth_basic           "${FUNNEL_REALM}";
    auth_basic_user_file /etc/nginx/funnel.htpasswd;

    client_max_body_size 10M;
    client_body_buffer_size 128k;
    proxy_connect_timeout 90;
    proxy_send_timeout 90;
    proxy_read_timeout 90;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /login {
        limit_req zone=funnel_login burst=20 nodelay;
        proxy_pass http://funnel_cms_contest;
        proxy_redirect off;
    }

    location / {
        proxy_pass http://funnel_cms_contest;
        proxy_redirect off;
    }

    location /ranking/ {
        ${RANKING_AUTH_DIRECTIVES}
        proxy_pass http://funnel_cms_ranking/;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        limit_req zone=funnel_ranking burst=10 nodelay;
    }

    location /ws {
        proxy_pass http://funnel_cms_contest;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js)$ {
        proxy_pass http://funnel_cms_contest;
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    access_log /var/log/nginx/funnel_contest_access.log;
    error_log /var/log/nginx/funnel_contest_error.log;
}

# ── Funnel: Admin Panel (port 8892) ──────────────────────────────
server {
    listen ${FUNNEL_PANEL_LISTEN};
    server_name _;

    auth_basic           "${FUNNEL_REALM}";
    auth_basic_user_file /etc/nginx/funnel.htpasswd;

    client_max_body_size 10M;
    client_body_buffer_size 128k;
    proxy_connect_timeout 90;
    proxy_send_timeout 90;
    proxy_read_timeout 90;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://funnel_cms_admin_panel;
        proxy_redirect off;
    }

    location /classic/ {
        proxy_pass http://funnel_cms_classic_admin/;
        proxy_redirect off;
    }

    access_log /var/log/nginx/funnel_admin_access.log;
    error_log /var/log/nginx/funnel_admin_error.log;
}

# ── Funnel: Ranking (port 8893) ──────────────────────────────────
server {
    listen ${FUNNEL_RANKING_LISTEN};
    server_name _;

    auth_basic           "${FUNNEL_REALM}";
    auth_basic_user_file /etc/nginx/funnel.htpasswd;

    client_max_body_size 10M;
    client_body_buffer_size 128k;
    proxy_connect_timeout 90;
    proxy_send_timeout 90;
    proxy_read_timeout 90;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        ${RANKING_AUTH_DIRECTIVES}
        proxy_pass http://funnel_cms_ranking/;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        limit_req zone=funnel_ranking burst=10 nodelay;
    }

    access_log /var/log/nginx/funnel_ranking_access.log;
    error_log /var/log/nginx/funnel_ranking_error.log;
}
