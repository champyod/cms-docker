# Grader domain nginx config — envsubst template
# Rendered by __domain.sh → config/grader.nginx.conf
# Render with: envsubst '$DOMAIN_NAME $ADMIN_DOMAIN ...' < template > output
# Only listed ${VAR} placeholders are substituted; $host/$remote_addr etc. left intact.
#
# Optional domains. Every region between `# @block <name>` and `# @end block` is
# emitted only when that domain is configured; __domain.sh strips the others, so an
# unset domain never reaches nginx as an empty server_name. ACME_HOST_NAMES lists
# every configured name for the port-80 vhost, because Let's Encrypt validates all
# SANs of one certificate against :80 and the challenge must answer for each of them.
# CERT_LINEAGE_DOMAIN is the lineage certbot created the certificate under: the primary
# domain when set, otherwise the first domain that is set.
#
# Routing. No upstream, path prefix or service name is written here: the upstreams and
# every `location` block come from the route table in __domain_routes.sh, which owns
# the only copy of that mapping. A route answers both on the vhost named by its domain
# and at its configured sub-path on the primary vhost.

# Rate limit zones — local fallback (always defined, never removed)
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=ranking_auth:10m rate=10r/s;

# Per-user bucket — key from X-User header or session cookie, falls back to IP
map $http_x_user $limit_user_tmp {
    default $http_x_user;
    ""      $cookie_session;
}
map $limit_user_tmp $limit_key {
    default $limit_user_tmp;
    ""      $binary_remote_addr;
}
limit_req_zone $limit_key zone=per_user:10m rate=5r/s;

# Redis distributed limit — rendered via __domain.sh polyfill
# When REDIS_RATE_LIMIT=1: resolver + upstream for redis-rate-limit:6379
# When REDIS_RATE_LIMIT=0: comment only, no upstream (local limit_req remains)
${REDIS_UPSTREAM_BLOCK}
${REDIS_LUA_PLACEHOLDER}

# ── Upstreams ──────────────────────────────────────────────────────
# One upstream per route-table row, named after the row. Built by
# __domain_routes.sh, which holds the only copy of the service → container mapping;
# an upstream is emitted for every row whether or not a domain is configured for it,
# because a route still answers on the primary vhost without one of its own.
${UPSTREAM_BLOCKS}

# ── Server 1: HTTP → HTTPS redirect + ACME challenge ──────────────
# Always rendered. default_server answers for any Host, which is what lets a single
# :80 forward validate every SAN on the certificate.
server {
    listen 80 default_server;
    server_name ${ACME_HOST_NAMES};

    ${ACME_HTTP01_CHALLENGE_ON_80}
    ${NGINX_METRICS_LOCATION}

    location / {
        return 301 https://$host$request_uri;
    }
}

# @block primary
# ── Server 2: primary (contest + ranking + WS) ─────────────────────
server {
    listen 443 ssl http2;
    server_name ${DOMAIN_NAME};

    ssl_certificate     /etc/letsencrypt/live/${CERT_LINEAGE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_LINEAGE_DOMAIN}/privkey.pem;
    include /etc/nginx/conf.d/nginx-ssl.conf;
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}; includeSubDomains" always;

    ${ACME_HTTP01_CHALLENGE_ON_443}

    client_max_body_size 10M;
    client_body_buffer_size 128k;
    proxy_connect_timeout 90;
    proxy_send_timeout 90;
    proxy_read_timeout 90;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /login {
        limit_req zone=admin_login burst=20 nodelay;
        ${PER_USER_LOGIN_DIRECTIVES}
        proxy_pass http://${PRIMARY_UPSTREAM};
        proxy_redirect off;
    }

    # Every route in the table, at its configured sub-path. The root route is the
    # one that owns this vhost; the rest sit in front of it. Built by
    # __domain_routes.sh because envsubst cannot repeat a placeholder.
    ${PRIMARY_ROUTE_BLOCKS}

    location /ws {
        proxy_pass http://${PRIMARY_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js)$ {
        proxy_pass http://${PRIMARY_UPSTREAM};
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    access_log /var/log/nginx/grader_access.log;
    error_log /var/log/nginx/grader_error.log;
}
# @end block

# @block admin
# ── Server 3: admin panel (Next.js) + classic admin ───────────────
server {
    listen 443 ssl http2;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CERT_LINEAGE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_LINEAGE_DOMAIN}/privkey.pem;
    include /etc/nginx/conf.d/nginx-ssl.conf;
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}; includeSubDomains" always;

    ${ACME_HTTP01_CHALLENGE_ON_443}

    client_max_body_size 10M;
    client_body_buffer_size 128k;
    proxy_connect_timeout 90;
    proxy_send_timeout 90;
    proxy_read_timeout 90;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # WHY: this vhost fronts the admin panel, which derives its login rate-limit
    # key from the first entry of this header. Appending to a client-supplied
    # value would let the client choose its own bucket, so assert the address
    # the connection actually came from.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The routes that answer on this vhost: the one that owns it, plus any table
    # row that names the same domain with a path of its own.
    ${ADMIN_ROUTE_BLOCKS}

    access_log /var/log/nginx/admin_access.log;
    error_log /var/log/nginx/admin_error.log;
}
# @end block

# @block oj
# ── Server 4: external OJ backend via host-gateway ────────────────
server {
    listen 443 ssl http2;
    server_name ${OJ_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CERT_LINEAGE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_LINEAGE_DOMAIN}/privkey.pem;
    include /etc/nginx/conf.d/nginx-ssl.conf;
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}; includeSubDomains" always;

    ${ACME_HTTP01_CHALLENGE_ON_443}

    client_max_body_size 100M;
    client_body_buffer_size 128k;
    proxy_connect_timeout 90;
    proxy_send_timeout 90;
    proxy_read_timeout 90;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    ${OJ_ROUTE_BLOCKS}

    access_log /var/log/nginx/oj_access.log;
    error_log /var/log/nginx/oj_error.log;
}
# @end block

