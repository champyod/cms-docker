*~
.DS_Store
*.mo
.*.sw?
*.pyc
build
dist
cms.egg-info
.testfailures
.unittestfailures
.coverage*
/cache/
/lib/
/log/
.vagrant/
codecov/
.dev/
test_logs/

# Customizable CMS Configuration
config.toml

# Environment Configuration
.env
.env.*

# Local overrides — gitignored for inside info / prod stay-off
.env.local
.env.*.local
*.local
*.pem.local
# Security feed: the template is committed, the live copy (.env.security) stays local
!.env.security.example
docker-compose.override.yml
docker-compose.expose.yml

# Security agent queue, results and state — written by the panel, applied on the host
.security-agent/

# VSCode settings
.vscode/

.agent/environment.md
.result
docker-compose.registry.generated.yml
# Rendered by ./cms config sync from the service registry; regenerated on every run.
config/generated/
docker-compose.tailscale.generated.yml
admin-panel/.env

# Agent tools
.claude/
/CMS-ENTRYPOINT-NOTES.md

# Generated / runtime secrets
config/funnel.htpasswd
config/grader.nginx.conf
config/letsencrypt/
config/monitor_targets.json
certbot-webroot/
.domain.lock

# Optional features — local HSM/Vault/mTLS artefacts (gitignored, not for prod by default)
config/hsm/
config/hsm/*.db
*.db
config/vault/data/
config/vault/*.hcl.local
config/mtls/
*.pem.local
config/*.pem
config/*.pem.local

# Backup archives
backups/*.tar.gz

# Monitoring data (Docker volumes — not files, but ignore stray local copies)
prometheus-data/
grafana-data/
config/prometheus/data/

# WAF ModSecurity audit/debug logs (plan-first; DetectionOnly writes heavily)
modsec_audit.log
modsec_debug.log
config/modsecurity/modsec_audit.log
config/modsecurity/modsec_debug.log
waf-logs/
cms-waf-logs/

# Rust build artifacts for the ranking service
ranking-web/target/

# Generated parity captures: the script writes here by default.
ranking-web/tests/fixtures/parity/captured/*/

# Generated per CI run from the panel's waiver table (security/waivers.json): the ids that may be
# suppressed are waiver rows, so a local .trivyignore must never be committed.
.trivyignore

