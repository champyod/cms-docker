# This file is auto-generated by `./cms config sync` from config.toml.
# Do not edit directly — edit config.toml instead.

# Contest to deploy (canonical — use CONTEST_ID; ACTIVE_CONTEST_ID is deprecated but still mapped by `make env`)
CONTEST_ID=1

# Contest public domain (when behind domain proxy with ACCESS_METHOD=domain).
# Set to the FQDN contestants use, e.g. cms.local or contest.cms.local
CONTEST_DOMAIN=cms.local
# ACTIVE_CONTEST_ID is deprecated — if set and CONTEST_ID is empty, `make env` maps it to CONTEST_ID with a warning
# ACTIVE_CONTEST_ID=

# Contest web server listen — THESE are the vars compose reads (see docker-compose.yml contest-web-server):
CONTEST_LISTEN_PORT=8888
CONTEST_LISTEN_ADDRESS=0.0.0.0
# Port mapping on the host (optional override; defaults to CONTEST_LISTEN_PORT)
# CONTEST_PORT_EXTERNAL=8888
# Bind IP for host port (default 0.0.0.0)
# CONTEST_BIND_IP=0.0.0.0

# Legacy: ACTIVE_CONTEST_PORT is mapped to CONTEST_LISTEN_PORT by `make env` / inject scripts if CONTEST_LISTEN_PORT is empty
ACTIVE_CONTEST_PORT=8888

# Global security key for session management
SECRET_KEY=

# Default settings (inherited by new contests)
COOKIE_DURATION=10800
ACCESS_METHOD=public_port
# Number of reverse-proxy hops between client and the contest web server.
# 1 = single proxy (default, typical for nginx/traefik in front).
# Set to 2 if there are two proxies (e.g. CDN → nginx → container).
NUM_PROXIES_USED=1
MAX_SUBMISSION_LENGTH=100000
MAX_INPUT_LENGTH=5000000
SUBMIT_LOCAL_COPY=true

# Infrastructure defaults
CONTEST_WEB_CPU_LIMIT=2
CONTEST_WEB_MEMORY_LIMIT=2G
ENABLE_TLS=false
