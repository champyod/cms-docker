# Security feed — copy to .env.security and fill in. The live file is gitignored.
#
# WHY a separate file from .env: the feed is optional and off by default, and it needs a
# GitHub token plus a docker socket. Keeping it out of the main env file means enabling the
# feed never changes the base stack's environment — and a live token cannot be staged by
# habit with the rest of .env.
#
# compose reads this file IN ADDITION to .env when told to (later files win, so a key set
# here overrides the same key in .env):
#   docker compose --env-file .env --env-file .env.security \
#     -f docker-compose.yml -f docker-compose.security.yml --profile security up -d
# WHY both: --env-file replaces .env rather than adding to it, so passing only this file would
# strip the base stack's own variables. IMG_TAG (the scan image tag) keeps coming from .env.

# --- switch and identity -------------------------------------------------------------
# 1 = the scheduled scan, the Diun translator and Renovate do work; 0 = they start and idle.
# WHY: the profile decides WHICH containers run, this decides whether they DO anything, so a
# host can carry the overlay before it reports anywhere.
SECURITY_ENABLED=0

# Name the panel shows in the findings' host column. WHY: two hosts reporting the same CVE
# must be distinguishable — use `hostname -s`.
SECURITY_HOST=

# Panel base URL; the producer appends /api/security/findings. WHY the service name: the
# containers share cms-network, so no host port and no DNS work is needed.
PANEL_URL=http://admin-panel-next:3000

# Bearer token the ingest route compares in constant time. WHY here and not in config.toml:
# it is machine-to-machine only. Generate with `openssl rand -hex 32`, set the same value on
# the panel. Rotation steps: docs/SECURITY-FEED.md → Operating.
SECURITY_FEED_TOKEN=

# --- schedules (container time; UTC unless the service sets TZ) -----------------------
# Cron for the nightly osv + rootfs pass. WHY nightly: a CVE published today has to be
# visible tomorrow, and the scan is seconds when the cache volume is warm.
SECURITY_SCAN_SCHEDULE=0 3 * * *
# Cron for Diun's registry sweep — every 6 h is Diun's own documented default.
DIUN_WATCH_SCHEDULE=0 */6 * * *
# Seconds between Renovate passes. WHY not cron: the CLI exits after each pass, so the
# container loop is the period.
RENOVATE_INTERVAL_SECONDS=86400

# --- Renovate ------------------------------------------------------------------------
# GitHub token with contents + pull requests on this repo. WHY not an org-scoped PAT: the
# container is told exactly one repository and must not be able to open PRs elsewhere.
RENOVATE_TOKEN=
# owner/repo — the only repository Renovate processes (autodiscover is off).
RENOVATE_REPOSITORIES=
RENOVATE_LOG_LEVEL=info

# --- Diun translator debug port ------------------------------------------------------
# Loopback port so a sample Diun body can be POSTed at the translator by hand. WHY published
# at all: it is the only way to test the translation without waiting for a registry change.
SECURITY_BRIDGE_PORT=8099
SECURITY_BRIDGE_BIND_IP=127.0.0.1
