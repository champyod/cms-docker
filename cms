#!/usr/bin/env bash
# cms — one-stop bootstrap orchestrator for the CMS Docker platform.
#
# Zero-argument invocation walks the full lifecycle:
#   prereqs -> env -> core -> cms-init -> prisma-sync -> admin -> contest
#   -> worker -> monitor -> superadmin -> health verification
#
# docker-compose.yml owns service dependencies/ordering; this script owns the
# cross-stack sequence and human-facing decisions. Minor/update utilities live
# under scripts/__*.sh and are invoked from here — never run them directly.
#
# Usage: ./cms.sh [--no-sample] [--skip step1,step2] [--yes] [-h]
set -euo pipefail

cd "$(dirname "$0")"

# --no-tui anywhere in args → force plain CLI mode (skip TUI routing)
for _a in "$@"; do
  [[ "$_a" == "--no-tui" ]] && { CMS_NO_TUI=1; export CMS_NO_TUI; }
done
_ARGS=(); for _a in "$@"; do [[ "$_a" == "--no-tui" ]] || _ARGS+=("$_a"); done
set -- "${_ARGS[@]}"

# ---- subcommand dispatch ----
cmd_usage() {
  cat <<'CMDS'
cms — CMS platform control plane

Usage:
  ./cms                     full bootstrap lifecycle (options below)
  ./cms <command> [args]

Commands:
  help                      this help
  setup                     first-time guided setup (fresh or update wizard)
  update                    interactive configuration update wizard
  fix                       non-interactive repair of missing/insecure config
  deploy <stack> [--img]    make core|admin|contest|worker|infra [-img]; stack=all loops
  stop [stack]              stop one stack or all
  clean [stack]             clean one stack or all
  pull [stack]              pull images for one stack or all
  db <init|reset|clean|sync> database lifecycle shortcuts
  admin-create              create superadmin account
  status                    live service status dashboard
  monitor                   monitoring/backup operations UI
  backup [drill]            run backup now; 'drill' tests the restore path
  restore <archive>         restore a backup archive
  doctor                    preflight environment checks
  test                      smoke-test the deployment
  worker [edit|deploy|stop|list]  fleet TUI / deploy all shards / stop / show
  worker server             TUI: pick which main server this worker connects to
  worker connect|cgroup     attach to a worker / set up sandbox cgroups
  tailscale setup|status|remove
                            tailnet HTTPS front for admin/ranking UIs
  expose                    TUI: pick local/public/tailscale wiring per UI
  funnel setup|passwd|remove|status
                            public ts.net access behind basic auth (no tailnet)
  contest create            create contests from YAML
  update-server             shard-aware server update flow

Examples:
  ./cms setup
  ./cms deploy core --img
  ./cms db reset
  ./cms backup drill
CMDS
}

handle_subcommand() {
  # TTY-gated interactive layer: real terminals get the TUI router; pipes,
  # non-tty contexts, --no-tui flag, incompatible forms (--workers-json,
  # drill) and CMS_NO_TUI=1 fall through to the plain handlers below unchanged.
  if [[ -t 0 && -t 1 && -z "${CMS_NO_TUI:-}" ]]; then
    case "${1:-}:${2:-}" in
      status:--workers-json|backup:drill) : ;;
      *)
        case "$1" in
          status|monitor|backup|restore|doctor|test|db|admin-create|contest|pull|stop|clean|deploy|tailscale|funnel|update-server|expose)
            exec bash scripts/__tui/__main.sh "$@"
            ;;
        esac
        ;;
    esac
  fi
  case "$1" in
    help|-h) cmd_usage; exit 0 ;;
    setup)
      mode_args=(--fresh)
      if [[ -f .env.core ]]; then
        read -r -p "Existing install detected — run the interactive update wizard instead? [Y/n] " yn || yn="n"
        if [[ ! "$yn" =~ ^[Nn] ]]; then mode_args=(); fi
      fi
      exec bash scripts/__update_engine.sh ${mode_args[@]+"${mode_args[@]}"} "${@:2}"
      ;;
    update) shift; exec bash scripts/__update_engine.sh "$@" ;;
    fix)    exec bash scripts/__update_engine.sh --fix ;;
    deploy)
      stack="${2:-}"
      [[ -z "$stack" ]] && { echo "usage: cms deploy <core|admin|contest|worker|infra|all> [--img]" >&2; exit 2; }
      img=""
      [[ "${3:-}" == "--img" ]] && img=1
      run_stack() {
        if [[ -n "$img" ]]; then
          DEPLOYMENT_TYPE_OVERRIDE=img make "$1"
        else
          make "$1"
        fi
      }
      case "$stack" in
        worker)
          # Interactive terminal -> fleet TUI (pick/edit/deploy workers).
          if [[ -t 0 && -z "$img" && -f .env.core && -f .env.worker ]]; then
            exec bash scripts/__tui/runners/__fleet-actions.sh tui
          fi
          run_stack worker; exit "$?" ;;
        core|admin|contest|infra) run_stack "$stack"; exit "$?" ;;
        all)
          rc=0
          for s in core infra admin contest worker; do run_stack "$s" || rc=1; done
          exit "$rc" ;;
        *) echo "unknown stack: $stack" >&2; exit 2 ;;
      esac ;;
    stop|clean)
      action="$1"
      stack="${2:-all}"
      case "$stack" in
        all)
          if [[ "$action" == "clean" ]]; then exec make clean; fi
          rc=0
          for s in core admin contest worker infra; do make "${s}-stop" || rc=1; done
          exit "$rc" ;;
        core|admin|contest|worker|infra) exec make "${stack}-${action}" ;;
        *) echo "unknown stack: $stack" >&2; exit 2 ;;
      esac ;;
    pull)
      stack="${2:-all}"
      case "$stack" in
        all) exec make pull ;;
        core|admin|contest|worker|infra) exec make "pull-${stack}" ;;
        *) echo "unknown stack: $stack" >&2; exit 2 ;;
      esac ;;
    db)
      sub="${2:-}"
      case "$sub" in
        init)  exec make cms-init ;;
        reset) exec make db-reset ;;
        clean) exec make db-clean ;;
        sync)  exec make prisma-sync ;;
        *) echo "usage: cms db <init|reset|clean|sync>" >&2; exit 2 ;;
      esac ;;
    admin-create) exec make admin-create ;;
    status)
      if [[ "${2:-}" == "--workers-json" ]]; then exec bash scripts/__worker_status_json.sh "${@:3}"; fi
      shift; exec bash scripts/__status.sh "$@" ;;
    monitor) shift; exec bash scripts/__monitor.sh "$@" ;;
    backup)
      if [[ "${2:-}" == "drill" ]]; then shift 2; exec bash scripts/__backup_drill.sh "$@"; fi
      exec make backup ;;
    restore) shift; exec bash scripts/__restore.sh "$@" ;;
    doctor)  exec bash scripts/__preflight.sh ;;
    test)    shift; exec bash scripts/__smoke-test.sh "$@" ;;
    worker)
      sub="${2:-}"
      case "$sub" in
        edit|tui) shift; exec bash scripts/__tui/runners/__fleet-actions.sh "${@:2}" ;;
        deploy)   shift 2; exec bash scripts/__worker_tui.sh deploy "${@:2}" ;;
        stop)     shift 2; exec bash scripts/__worker_tui.sh stop "${2:-all}" ;;
        list)     exec bash scripts/__worker_tui.sh list ;;
        server)  shift 2; exec bash scripts/__tui/wizards/__server.sh "${@:2}" ;;
        connect) shift 2; exec bash scripts/__worker_connect.sh "$@" ;;
        cgroup)  shift 2; exec bash scripts/__worker_cgroup_setup.sh "$@" ;;
        *) echo "usage: cms worker <edit|deploy [shard]|stop|list|connect|cgroup>" >&2; exit 2 ;;
      esac ;;
    tailscale)
      shift
      exec bash scripts/__tailscale_serve.sh "${@:-setup}" ;;
    expose)
      exec bash scripts/__tui/wizards/__expose.sh ;;
    funnel)
      shift; exec bash scripts/__funnel.sh "${@:-status}" ;;
    contest)
      sub="${2:-}"
      [[ "$sub" == "create" ]] || { echo "usage: cms contest create <yaml...>" >&2; exit 2; }
      shift 2; exec bash scripts/__create_contests.sh "$@" ;;
    update-server) shift; exec bash scripts/__update-server.sh "$@" ;;
    *) return 1 ;;
  esac
}

if [[ $# -gt 0 ]]; then
  if ! handle_subcommand "$@"; then
    echo "Unknown command: $1" >&2
    cmd_usage >&2
    exit 2
  fi
fi

NO_SAMPLE=0
ASSUME_YES=0
SKIPS=""

usage() {
  cat <<'USAGE'
cms — one-stop CMS platform bootstrap

Usage: ./cms.sh [options]

Options:
  --no-sample        Do not import examples/contests.yaml into an empty DB
  --skip <a,b,...>   Skip steps: env,core,cms-init,prisma-sync,admin,
                     contest,worker,monitor,admin-create,verify
  --yes              Non-interactive mode: skips tty-only prompts,
                     prints their manual commands instead
  -h, --help         This help

Everything is idempotent — safe to re-run after partial failures.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-sample) NO_SAMPLE=1 ;;
    --yes|-y)    ASSUME_YES=1 ;;
    --skip)      shift; SKIPS="${1:-}" ;;
    -h|--help)   usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

is_skipped() { [[ ",$SKIPS," == *",$1,"* ]]; }

source scripts/__lib/common.sh 2>/dev/null || true
declare -F log_info >/dev/null || log_info() { echo "[INFO] $*"; }
declare -F log_warn >/dev/null || log_warn() { echo "[WARN] $*" >&2; }
declare -F log_die  >/dev/null || log_die()  { echo "[FAIL] $*" >&2; exit "${2:-1}"; }

RESULTS=()
record() { RESULTS+=("$1|$2"); printf '  %-14s %s\n' "$1:" "$2"; }
run_step() {
  local name="$1" softfail="${2:-}" cmd="$3"
  printf '\n== [%s] ==\n' "$name"
  if is_skipped "$name"; then record "$name" "SKIPPED (--skip)"; return 0; fi
  local rc=0
  bash -c "$cmd" || rc=$?
  if [[ $rc -eq 0 ]]; then
    record "$name" "OK"
  elif [[ "$softfail" == "soft" ]]; then
    record "$name" "WARN (see above)"
  else
    record "$name" "FAILED"
    return 1
  fi
}

wait_container() {
  local name="$1" timeout="${2:-180}" elapsed=0 state
  while :; do
    state=$(docker inspect -f '{{.State.Health.Status}}' "$name" 2>/dev/null || echo missing)
    [[ "$state" == "healthy" ]] && return 0
    [[ "$state" == "exited" || "$state" == "dead" ]] && {
      log_warn "$name is $state — last logs:"; docker logs --tail 20 "$name" 2>&1 | sed 's/^/    /'; return 1; }
    (( elapsed >= timeout )) && { log_warn "timeout waiting for $name ($state)"; return 1; }
    sleep 5; elapsed=$((elapsed+5))
  done
}

curl_up() { curl -fsS -o /dev/null --max-time 5 "$1" >/dev/null 2>&1; }

echo "==============================================="
echo " CMS one-stop bootstrap"
echo "==============================================="
[[ -t 0 ]] || ASSUME_YES=1

# Interactive no-args → master dashboard (btop grid). Piped/--yes/--skip/
# --no-tui → bootstrap lifecycle as before.
if [[ -t 0 && -t 1 && $ASSUME_YES -eq 0 && -z "$SKIPS" && -z "${CMS_NO_TUI:-}" && $# -eq 0 ]]; then
  if [[ -x .tools/cms-tui/cms-tui-linux-x86_64 ]]; then
    exec .tools/cms-tui/cms-tui-linux-x86_64
  fi
  exec bash scripts/__tui/__main.sh
fi

run_step prereqs "" '
  command -v docker >/dev/null || exit 1
  docker info >/dev/null 2>&1 || { echo "docker daemon unreachable"; exit 1; }
'

run_step env "" 'make env'

if ! is_skipped core; then
  run_step core "" 'make core'
  echo "-- waiting for core services --"
  wait_container cms-database 180    || record "core-wait" "WARN database"
  wait_container cms-log-service 240 || record "core-wait" "WARN log-service"
fi

is_skipped cms-init    || run_step cms-init    ""    'make cms-init'
is_skipped prisma-sync || run_step prisma-sync ""    'make prisma-sync'

run_step admin "" 'make admin'

# Optional tailnet HTTPS front (opt-in via TAILSCALE_SERVE=1 in .env.admin)
if [[ "$(awk -F= '$1=="TAILSCALE_SERVE"{gsub(/[ \r]/,"",$2);print $2}' .env.admin 2>/dev/null || true)" == 1* ]]; then
  if command -v tailscale >/dev/null 2>&1; then
    run_step tailscale-serve soft 'bash scripts/__tailscale_serve.sh setup'
  else
    record "tailscale-serve" "SKIPPED — tailscale CLI not found"
  fi
fi

if ! is_skipped contest; then
  run_step contest "" 'make contest'
  if [[ $NO_SAMPLE -eq 0 ]]; then
    cnt=$(docker exec cms-database psql -U "${POSTGRES_USER:-cmsuser}" -d "${POSTGRES_DB:-cmsdb}" -tAc \
          "SELECT count(*) FROM information_schema.tables WHERE table_name='contests'" 2>/dev/null | tr -d "[:space:]") || cnt=""
    if [[ "$cnt" == "1" ]]; then
      have=$(docker exec cms-database psql -U "${POSTGRES_USER:-cmsuser}" -d "${POSTGRES_DB:-cmsdb}" -tAc \
             "SELECT count(*) FROM contests" 2>/dev/null | tr -d "[:space:]") || have="?"
      if [[ "$have" == "0" ]]; then
        log_info "DB has no contests — importing sample (examples/contests.yaml)"
        run_step sample-contest soft './scripts/__create_contests.sh -f examples/contests.yaml'
        log_info "Set CONTEST_ID in .env.contest to the desired sample id, then: make env && make contest"
      else
        record "sample-contest" "SKIPPED (contests exist: $have)"
      fi
    fi
  fi
fi

run_step worker soft '
  # Fleet model: deploy every WORKER_N registry entry (seeded from the
  # legacy single-worker config on first run). Registry-only (remote)
  # entries are skipped automatically.
  if ! bash scripts/__worker_tui.sh deploy all; then
    echo "Worker failed — most likely isolate cgroup path missing on host."
    echo "Fix: sudo ./scripts/__worker_cgroup_setup.sh   (then re-run: ./cms worker deploy)"
    exit 1
  fi
'

run_step monitor soft '
  mkdir -p backups
  if ! make infra; then
    echo "Monitor failed — if permission denied on docker.sock set DOCKER_GID:"
    echo "  stat -c %g /var/run/docker.sock   # put value in .env.infra as DOCKER_GID=<n>"
    exit 1
  fi
'

if ! is_skipped admin-create; then
  echo ""
  if [[ $ASSUME_YES -eq 1 ]]; then
    record "admin-create" "SKIPPED (non-interactive) — run: make admin-create"
  else
    read -r -p "Create first superadmin now? [Y/n] " yn || yn="n"
    if [[ ! "$yn" =~ ^[Nn] ]]; then
      run_step admin-create "" 'make admin-create' || record "admin-create" "FAILED"
    else
      record "admin-create" "SKIPPED — run later: make admin-create"
    fi
  fi
fi

echo ""
echo "== Health verification =="
VFAIL=0
for svc in cms-database cms-log-service cms-resource-service cms-scoring-service cms-checker-service; do
  s=$(docker inspect -f '{{.State.Health.Status}}' "$svc" 2>/dev/null || echo absent)
  printf '  %-24s %s\n' "$svc" "$s"
  [[ "$s" == "healthy" ]] || VFAIL=1
done
for probe in "contest-web http://127.0.0.1:${ACTIVE_CONTEST_PORT:-8888}/" \
             "admin-panel http://127.0.0.1:${ADMIN_NEXT_PORT_EXTERNAL:-8891}/" \
             "legacy-admin http://127.0.0.1:${ADMIN_PORT_EXTERNAL:-8889}/" \
             "ranking http://127.0.0.1:${RANKING_PORT_EXTERNAL:-8890}/"; do
  n=${probe%% *}; u=${probe#* }
  if curl_up "$u"; then printf '  %-24s UP\n' "$n"; else printf '  %-24s DOWN\n' "$n"; VFAIL=1; fi
done

echo ""
echo "================= SUMMARY ================="
for r in "${RESULTS[@]}"; do printf '  %-38s %s\n' "${r%%|*}" "${r#*|}"; done
echo "==========================================="
if [[ $VFAIL -eq 1 ]]; then
  log_warn "Some services are not fully up yet — inspect logs above (first boot can take minutes)."
  exit 1
fi
log_info "Platform is up."
