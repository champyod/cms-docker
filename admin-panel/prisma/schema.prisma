model monitor_targets {
  id             String   @id @default(cuid())
  url            String
  interval       Int      @default(60)
  timeout        Int      @default(5)
  expectedStatus Int      @default(200)
  alertDiscord   Boolean  @default(true)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("monitor_targets")
}

/// One named archive tree the Backup & Restore page offers. Locations are rows,
/// not config, so a schedule's reference is a real FK and Restrict keeps a
/// referenced tree from disappearing under a schedule that still names it. The
/// seeded system row stands for the legacy single tree: its `path` is empty
/// because that tree is whatever BACKUP_DIR mounts, not a configured path.
model backup_locations {
  id        String             @id @default(cuid())
  label     String
  path      String
  isSystem  Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  schedules backup_schedules[]

  @@map("backup_locations")
}

/// One archived run of a backup schedule, or of a backup an admin triggered by
/// hand. `scheduleId` stays NULL for manual runs and is deliberately not a
/// relation: run history outlives the schedule it came from, so deleting a
/// schedule must not delete the audit trail.
model backup_runs {
  id         String    @id @default(cuid())
  scheduleId String?
  kind       String
  tables     String[]  @db.VarChar
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  message    String?
  manifestTs String?

  @@index([startedAt], map: "ix_backup_runs_started_at")
  @@map("backup_runs")
}

/// A recurring selective backup. `nextRunAt` is what the backup poller compares
/// against the clock, so it is indexed together with `enabled`: every poll asks
/// for exactly `enabled = true AND nextRunAt <= now`.
model backup_schedules {
  id           String            @id @default(cuid())
  name         String            @unique
  tables       String[]          @db.VarChar
  intervalMins Int
  enabled      Boolean           @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime
  /// Backup location this schedule dumps into. A relation now that locations
  /// are rows; Restrict refuses deleting one a schedule still names. NULL
  /// targets the seeded system location — the meaning every row that predates
  /// locations already read into it.
  locationId   String?
  location     backup_locations? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([enabled, nextRunAt], map: "ix_backup_schedules_enabled_next_run_at")
  @@map("backup_schedules")
}

model users {
  id                  Int              @id @default(autoincrement())
  first_name          String           @db.VarChar
  last_name           String           @db.VarChar
  username            String           @unique @db.VarChar
  password            String           @db.VarChar
  email               String?          @db.VarChar
  timezone            String?          @db.VarChar
  preferred_languages String[]         @db.VarChar
  last_login_at       DateTime?
  status              String?
  organization        String?
  country             String?
  participations      participations[]
