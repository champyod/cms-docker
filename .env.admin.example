# CMS Admin Services Environment Configuration - TEMPLATE
# Copy to .env.admin.local for your actual configuration
# Author: CCYod | Repository: https://github.com/champyod/cms-docker
# =============================================================================
# This file overrides settings in .env.admin for local deployment
# Public IP address of your VPS/server

# -----------------------------------------------------------------------------
# CMS Configuration
# -----------------------------------------------------------------------------
# Loaded from .env.core
# CMS_CONFIG=/usr/local/etc/cms.toml
# CMS_RANKING_CONFIG=/usr/local/etc/cms_ranking.toml

# -----------------------------------------------------------------------------
# Access Method Configuration
# -----------------------------------------------------------------------------
# Loaded from .env.core
# ACCESS_METHOD=public_port
# PUBLIC_IP=YOUR_PUBLIC_IP_HERE

# -----------------------------------------------------------------------------
# Admin Web Server Configuration
# -----------------------------------------------------------------------------
ADMIN_LISTEN_ADDRESS=0.0.0.0
ADMIN_LISTEN_PORT=8889
ADMIN_PORT_EXTERNAL=8889

# Next.js Admin Panel Configuration
ADMIN_NEXT_PORT_EXTERNAL=8891
ADMIN_NEXT_DOMAIN=admin-next.cms.local
VITE_API_URL=http://localhost:8889
SERVER_BASE_URL=http://localhost
DEPLOYMENT_TYPE=img  # Controls `make <stack>` behavior: 'img' → pull + up --no-build, 'src' → up --build
# img: Makefile runs `docker compose --profile <stack> pull` then `up -d --no-build` (fast, production)
# src: Makefile runs `docker compose --profile <stack> up -d --build` (allows custom code, slower)

# Admin domain for Traefik/reverse proxy (only used if ACCESS_METHOD=domain)
# Defaults to: admin.${CMS_DOMAIN}
ADMIN_DOMAIN=admin.cms.local

# Admin session settings
ADMIN_COOKIE_DURATION=36000
# JWT signing secret for the Next.js admin panel session cookies.
# Must be a fixed, random 64-char hex string. Generate with:
#   openssl rand -hex 32
# WARNING: Changing this invalidates all existing sessions.
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# --- CAPTCHA for admin login (optional, disabled by default) -----------------
# Protects /auth/login after N failed attempts within 15 minutes per IP+user.
# Defaults keep CAPTCHA off unless explicitly enabled — no break when disabled.
# When enabled, CAPTCHA reduces automated brute-force before fail2ban bans at 5 fails.
# Provider switchable: turnstile (Cloudflare) or hcaptcha.
# Keys are server-only; site key is public, secret stays in server env (never bundled to client).
# No Redis required — in-memory Map with 15m TTL; Redis optional if REDIS_HOST is set elsewhere.
CAPTCHA_ENABLED=0
# CAPTCHA_PROVIDER=turnstile  # turnstile | hcaptcha
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=
# CAPTCHA_THRESHOLD=3         # failed attempts before CAPTCHA appears (4th attempt)
# CAPTCHA_BAN_THRESHOLD=5    # fail2ban still bans after 5 fails regardless of CAPTCHA

# -----------------------------------------------------------------------------
# Ranking Web Server Configuration
# -----------------------------------------------------------------------------
RANKING_LISTEN_ADDRESS=0.0.0.0
RANKING_LISTEN_PORT=8890
RANKING_PORT_EXTERNAL=8890

# Ranking domain for Traefik/reverse proxy (only used if ACCESS_METHOD=domain)
RANKING_DOMAIN=ranking.cms.local

# Ranking authentication
RANKING_USERNAME=admin
# Password format: cms_ranking_[memorable]
RANKING_PASSWORD=YOUR_RANKING_PASSWORD_HERE

# Score-feed push target (proxy/scoring -> ranking web server).
# Default: cms-ranking-web-server:8890 (same docker network) - leave unset.
# Only for a ranking node running on a DIFFERENT machine:
#RANKING_REMOTE=1
#RANKING_PUSH_HOST=100.x.y.z:8890

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Loaded from .env.core
# POSTGRES_DB=cmsdb
# POSTGRES_USER=cmsuser
# Password format: cms_postgres_[memorable]
# POSTGRES_PASSWORD=YOUR_DB_PASSWORD_HERE

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
# Loaded from .env.core
# CMS_LOG_DIR=/var/local/log/cms
# CMS_CACHE_DIR=/var/local/cache/cms
# CMS_DATA_DIR=/var/local/lib/cms

# Admin specific paths
CMS_RANKING_LOG_DIR=/var/local/log/cms/ranking
CMS_RANKING_LIB_DIR=/var/local/lib/cms/ranking

# -----------------------------------------------------------------------------
# Domain & TLS Configuration
# -----------------------------------------------------------------------------
# Primary domain for the CMS instance (used by Traefik/reverse proxy).
# Set to your actual FQDN when ACCESS_METHOD=domain in .env.core.
# DOMAIN_NAME=your-domain.com
# TLS certificate method: letsencrypt | provided | selfsigned
# letsencrypt: Auto-provision via certbot (requires DNS or HTTP challenge)
# provided:    Mount your own cert/key files
# selfsigned:  Generate self-signed cert (dev/testing only)
DOMAIN_CERT_METHOD=letsencrypt

# Admin panel public domain (e.g. admin.your-domain.com)
# Used by Traefik Host rule for routing admin traffic.
ADMIN_DOMAIN=admin.your-domain.com

# Ranking page public domain (e.g. ranking.your-domain.com)
RANKING_DOMAIN=ranking.your-domain.com

# HSTS (HTTP Strict Transport Security)
# Max-age in seconds. Set >0 to enable HSTS header on HTTPS responses.
# 300 = 5 min (safe for staging ramp-up); production: 31536000 (1 year)
HSTS_MAX_AGE=300

# Socket proxy — set 1 to proxy WebSocket connections through nginx/caddy
# for real-time score updates. 0 = direct (default for dev).
SOCKET_PROXY=0

# Enhanced monitoring — set 1 to enable HTTP endpoint health checks
# (requires config/monitor_targets.json). 0 = basic docker stats only.
MONITOR_ENHANCED=0

# --- Rate limiting (Redis + per-user bucket) --------------------------------
# REDIS_RATE_LIMIT: 0=local limit_req only (prod default), 1=Redis via redis-rate-limit (dev)
# PER_USER_LIMIT: 1=enable per_user bucket (5r/s, burst 20) using $http_x_user/$cookie_session → $limit_key
# When Redis is absent or REDIS_RATE_LIMIT=0, nginx falls back to local limit_req (5r/s admin_login, 10r/s ranking_auth).
REDIS_RATE_LIMIT=0
PER_USER_LIMIT=1
REDIS_HOST=redis-rate-limit
REDIS_PORT=6379

# --- WAF — OWASP ModSecurity CRS (optional, plan-first, disabled by default) --
# WAF is plan-first and optional; see .env.infra.example WAF section and docs/waf-tuning.md.
# Disabled by default (WAF_ENABLED=0). Enable with --profile waf and WAF_ENABLED=1.
# WAF works alongside CAPTCHA — both can be on at once; WAF does not replace CAPTCHA.
# Mirrored from .env.infra: prefer setting in .env.infra; these are defaults/overrides if present.
WAF_ENABLED=0
WAF_PORT=8080
WAF_PARANOIA=1
WAF_ANOMALY_INBOUND=5

# --- Tailscale HTTPS front (optional) --------------------------------------
# Set TAILSCALE_SERVE=1 and ./cms bootstrap registers `tailscale serve`
# listeners after the admin stack comes up. Ports are the PUBLIC https
# ports on your tailnet address; backends default to the *_PORT_EXTERNAL
# values above. Pair with TS hide: run `./cms tailscale setup --hide-ports`
# once to rebind raw ports to 127.0.0.1.
#TAILSCALE_SERVE=1
#TS_HTTPS_PANEL=8843
#TS_HTTPS_CLASSIC=8844
#TS_HTTPS_RANKING=8845

# --- Optional security features (disabled by default, opt-in via prompts) ----
# See .env.infra.example for full why/price/maintenance per feature.
# All disabled by default (0) — prod stays off unless explicitly enabled.
# HSM_ENABLED=0
# VAULT_ENABLED=0
# DNSSEC_ENABLED=0
# MTLS_WORKERS_ENABLED=0